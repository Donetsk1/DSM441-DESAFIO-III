<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".LibraryFragment">

    <TextView
        android:id="@+id/libraryTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_library"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/emptyLibraryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/empty_library_list"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/libraryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        tools:itemCount="3"
        tools:listitem="@layout/item_book_library" />

</LinearLayout>
